# ===== 运行环境 =====
NODE_ENV=development
PORT=3001

# ===== 数据库 =====
# docker-compose up -d 后可直接使用该连接串
DATABASE_URL=mysql://chenjiang:chenjiang@localhost:3306/knowledge_share
DATABASE_SSL=false
# 本地开发可开启自动同步表结构，生产必须为 false 并走 migration
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# ===== 跨域（多个来源用英文逗号分隔）=====
CORS_ORIGIN=http://localhost:5173

# ===== 管理端账号 =====
# 本地首次启动默认 admin/admin。生产首次启动配置 12–64 字符的密码。
AUTH_BOOTSTRAP_PASSWORD=

# 生产必填，至少 32 字符。开发留空会在每次后端启动时生成新密钥。
AUTH_JWT_SECRET=

# 海报报名链接的对外 Web 地址。留空时使用发起请求的站点地址。
PUBLIC_WEB_URL=

# 活动报名链接和报名凭证的稳定签名密钥，至少 32 字符。留空时使用 AUTH_JWT_SECRET。
ACTIVITY_LINK_SECRET=

# ===== AI（OpenAI 兼容接口，当前使用火山方舟）=====
# 需先在方舟控制台开通对应模型，再填入 API Key
AI_API_KEY=
# 兼容旧变量名，AI_API_KEY 优先
DEEPSEEK_API_KEY=
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_MODEL=doubao-seed-2-1-lite-260915
AI_TIMEOUT_MS=60000
AI_DISABLE_THINKING=true

# ===== Redis（定时推送队列 / BullMQ）=====
# 留空则不启用队列，定时推送退回每分钟扫表兜底
REDIS_URL=redis://localhost:6379/0
# 多个环境共用同一个 Redis 时用前缀隔离任务 key
REDIS_PREFIX=knowledge-share

# ===== 图片存储 =====
# local：存到 apps/backend/uploads；obs：华为云 OBS（需要先安装 esdk-obs-nodejs）
IMAGE_STORAGE=local
OBS_ENDPOINT=
OBS_BUCKET=
OBS_ACCESS_KEY_ID=
OBS_SECRET_ACCESS_KEY=
# 可选：CDN 或自定义公开访问域名，留空时使用 {OBS_ENDPOINT}/{OBS_BUCKET}
OBS_PUBLIC_BASE_URL=
